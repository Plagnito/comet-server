# Configuration du serveur Comet — copiez en `.env` et adaptez.
# Avec Docker, rien n'est obligatoire : ces réglages se passent dans docker-compose.yml.

# Port et interface d'écoute (le serveur sert l'API ET l'interface compilée)
PORT=4800
HOST=0.0.0.0
NODE_ENV=production

# Secret qui signe les sessions. OBLIGATOIRE hors Docker (l'image le génère seule).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ⚠️ Le changer déconnecte tout le monde.
JWT_SECRET=
JWT_EXPIRE=30d

# Adresse publique de votre serveur. Sert aux liens de partage, aux pièces jointes
# volumineuses et aux redirections OAuth.
# COMET_BASE_URL=https://comet.mon-domaine.fr

# Inscription libre : ouverte | fermee. Fermez-la une fois vos comptes créés.
# Le PREMIER compte créé sur un serveur sans administrateur devient administrateur.
COMET_INSCRIPTION=ouverte
# Promouvoir un compte existant au démarrage :
# COMET_ADMIN_EMAIL=vous@comet.mail

# Origines supplémentaires autorisées à appeler l'API depuis un navigateur. La page
# servie par CE serveur est toujours admise ; ne remplissez ceci que pour un autre site.
# COMET_ALLOWED_ORIGINS=https://app.exemple.com

# Clé qui scelle au repos les identifiants des comptes mail externes (IMAP/SMTP).
# Par défaut dérivée de JWT_SECRET.
# COMET_MAIL_SECRET=

# ── Comptes Gmail / Outlook en « 1 clic » (facultatif) ──────────────────────────
# Sans ces identifiants, un compte externe se connecte avec un mot de passe
# d'application IMAP/SMTP. Pour le « 1 clic », créez VOTRE application OAuth chez le
# fournisseur, avec pour adresse de retour :
#   <COMET_BASE_URL>/api/accounts/oauth/gmail/callback
#   <COMET_BASE_URL>/api/accounts/oauth/outlook/callback
# Google    → console.cloud.google.com → Identifiants → ID client OAuth (application Web)
# COMET_GOOGLE_CLIENT_ID=
# COMET_GOOGLE_CLIENT_SECRET=
# Microsoft → entra.microsoft.com → Inscriptions d'applications
# COMET_MS_CLIENT_ID=
# COMET_MS_CLIENT_SECRET=

# ── Pièces jointes pair-à-pair et visio à travers Internet (facultatif) ─────────
# Sur un même réseau local, rien à configurer. Sinon, idéalement VOTRE serveur coturn.
# COMET_STUN=stun:votre-serveur:3478
# COMET_TURN=turn:votre-serveur:3478
# COMET_TURN_USER=
# COMET_TURN_PASS=

# ── Notifications bureau (Web Push, facultatif) ─────────────────────────────────
# Générer la paire : node scripts/gen-vapid.js
# COMET_VAPID_PUBLIC=
# COMET_VAPID_PRIVATE=
# COMET_PUSH_SUBJECT=mailto:vous@mon-domaine.fr

# ── Mise à jour automatique depuis GitHub (installation sans Docker) ────────────
# AUTO_UPDATE=1
# GITHUB_REPO=Plagnito/comet-server
# UPDATE_BRANCH=main
